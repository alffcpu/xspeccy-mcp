# Writes the files that ship with the core into one C++ source, as byte arrays
# behind the tables src/xsp_builtin.h declares. Run by the build, not by
# configure - see cmake/builtin_resources.cmake for why - as
#
#   cmake -DXSP_OUT=<file.cpp> -DXSP_MACHINES_DIR=<dir> -DXSP_LAYOUTS=<file>
#         [-DXSP_ROMS_DIR=<dir>] -P embed_resources.cmake
#
# A directory or file that does not exist is an empty table, not an error: an
# upstream tree has no res/machines, and a build without roms passes no
# directory at all.

# One array per file, and the row that names it. Bytes rather than a string
# literal: MSVC caps a literal at 64K, and the larger roms are 512K.
function(_xsp_embed _table _path)
	get_filename_component(_name "${_path}" NAME)
	file(SIZE "${_path}" _size)
	file(READ "${_path}" _hex HEX)
	set(_id "d${_xsp_count}")
	math(EXPR _next "${_xsp_count} + 1")
	set(_xsp_count ${_next} PARENT_SCOPE)
	if(_size EQUAL 0)
		set(_bytes "0")		# an empty initializer is not C++
	else()
		string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
		# 32 bytes to a line rather than a 512K rom on one: a compiler that
		# reports a problem in here reports a line. CMake's regex has no {n},
		# so the pattern is spelt out.
		string(REPEAT "0x..," 32 _row)
		string(REGEX REPLACE "(${_row})" "\\1\n" _bytes "${_bytes}")
	endif()
	string(REPLACE "\\" "\\\\" _name "${_name}")
	string(REPLACE "\"" "\\\"" _name "${_name}")
	string(APPEND _xsp_data "const unsigned char ${_id}[] = {\n${_bytes}\n};\n")
	string(APPEND ${_table} "\t{\"${_name}\", ${_id}, ${_size}},\n")
	set(_xsp_data "${_xsp_data}" PARENT_SCOPE)
	set(${_table} "${${_table}}" PARENT_SCOPE)
endfunction()

# The table definition, or an empty set: a zero-length array is not C++ either.
function(_xsp_table _out _var _rows _count)
	if(_count EQUAL 0)
		set(${_out} "const Set ${_var} = {nullptr, 0};\n" PARENT_SCOPE)
	else()
		string(CONCAT _def
			"static const File ${_var}Files[] = {\n${_rows}};\n"
			"const Set ${_var} = {${_var}Files, ${_count}};\n")
		set(${_out} "${_def}" PARENT_SCOPE)
	endif()
endfunction()

set(_xsp_count 0)
set(_xsp_data "")

set(_machines "")
set(_machines_rows "")
if(XSP_MACHINES_DIR)
	file(GLOB _machines "${XSP_MACHINES_DIR}/*.conf")
	list(SORT _machines)
endif()
foreach(_f ${_machines})
	_xsp_embed(_machines_rows "${_f}")
endforeach()
list(LENGTH _machines _n_machines)

set(_layouts_rows "")
set(_n_layouts 0)
if(XSP_LAYOUTS AND EXISTS "${XSP_LAYOUTS}")
	_xsp_embed(_layouts_rows "${XSP_LAYOUTS}")
	set(_n_layouts 1)
endif()

set(_roms "")
set(_roms_rows "")
if(XSP_ROMS_DIR)
	file(GLOB _roms "${XSP_ROMS_DIR}/*.rom")
	list(SORT _roms)
endif()
foreach(_f ${_roms})
	_xsp_embed(_roms_rows "${_f}")
endforeach()
list(LENGTH _roms _n_roms)

_xsp_table(_t_machines kMachines "${_machines_rows}" ${_n_machines})
_xsp_table(_t_layouts kLayouts "${_layouts_rows}" ${_n_layouts})
_xsp_table(_t_roms kRoms "${_roms_rows}" ${_n_roms})

# Written beside the target and renamed into place, so a build interrupted
# halfway leaves the old file or none - never a truncated one that is newer
# than its inputs and would not be regenerated.
file(WRITE "${XSP_OUT}.part"
	"// Generated by cmake/embed_resources.cmake. Do not edit, and do not commit:\n"
	"// it lives in the build directory.\n"
	"#include \"xsp_builtin.h\"\n\n"
	"namespace xsp {\nnamespace builtin {\n\n"
	"namespace {\n${_xsp_data}}\n\n"
	"${_t_machines}${_t_layouts}${_t_roms}\n"
	"} // namespace builtin\n} // namespace xsp\n")
file(RENAME "${XSP_OUT}.part" "${XSP_OUT}")
