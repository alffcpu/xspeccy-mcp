# Single source of truth for versions. Read at build time by cmake/version.cmake
# and by build.py, so there is exactly one place to change and no way for the two
# to drift apart. Format is KEY = VALUE; anything after a # is a comment.
#
# Before this file existed the pinned Xpeccy version lived in build.py and the
# minimum the build would accept lived in cmake/xpeccy.cmake, separately, and
# nothing compared them. A tree newer than the pin was therefore accepted in
# silence, which is exactly the way a build stops being reproducible.

# The server's own version, reported over MCP as serverInfo.version and by
# --version. See CHANGELOG.md.
XSPECCY_MCP_VERSION = 1.5.0

# The emulator core the server is built and tested against. Since 1.4.0 that is
# xpeccy-plus (https://github.com/dotkoval/xpeccy-plus), not samstyle's upstream:
# the fork carries contended memory and I/O, machine definition files and the
# TSConf/SD-card hardware this server now depends on. The version string is the
# fork's VERSION file with "-plus" appended, which is what the build detects it
# as.
#
# Pinning to a name that moves is not a pin: upstream's `stable`/`minor` and the
# fork's `nightly` tags all move, so the name is for people and the commit below
# is what binds.
XPECCY_VERSION = 2026.6.2-plus

# What build.py actually downloads. A tag can be moved; a commit cannot, so the
# archive fetched by this SHA is the same bytes forever - as long as the commit
# stays reachable, which is why it is the one the release tag v2026.6.2 names on
# the fork's main branch. A commit no branch or tag holds (an unmerged branch
# tip) can be dropped by the host, and the pin with it.
XPECCY_COMMIT = 1f259fc8627058a1c71a4ce7c5588bd887a481f2

# The oldest source tree that compiles at all, which is a different fact from
# the one above. With the move to xpeccy-plus the floor is the fork itself: the
# adapter calls comp_set_cont()/vid_fnt_load() and reads machine definitions
# from res/machines, none of which an upstream samstyle tree has. The build
# probes spectrum.h for comp_set_cont - a name that exists only in the fork -
# rather than a version, because a name that is there is a tree that compiles.
XPECCY_MINIMUM = 2026.6.2-plus

# SHA-256 of the parts of the Xpeccy tree this build actually uses: src/libxpeccy
# (what we compile) plus the runtime resources xpeccy-plus made semantic inputs -
# res/machines, res/layouts.conf and config/roms, which decide what a machine IS
# and which ROM it boots. Not a hash of the tarball: GitHub generates those on
# the fly and has changed their compression before, so a tarball hash goes stale
# without a single line of source changing. This is computed over the files
# themselves - each relative path and its contents, sorted, NUL-separated.
#
# Line endings are normalised to LF first, and that is not tidiness. A tree that
# reached the disk through a Windows git checkout carries CRLF, and such a copy
# differs from the tag's own tarball in most of its files for that reason alone
# while being character for character the same source. Hashing raw bytes would
# report a corrupt dependency on every Windows machine and be ignored within a
# week, which is worse than not checking.
XPECCY_LIBXPECCY_SHA256 = cff04a549f6bd76d4acf710a814397462fc224a7013d34217915129a56e7e1eb
